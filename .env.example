# EMPLEADOS_IA — variables de entorno V1
# Copiar a .env y ajustar (NO versionar .env)

# -----------------------------------------------------------------------------
# AMBIENTE (dev | test | prod)
# -----------------------------------------------------------------------------
APP_ENV=dev

# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------
# Desarrollo local (SQLite — predeterminado sin Docker):
# DATABASE_URL=sqlite:///D:/EMPLEADOS_IA/data/enterprise_ai_os.db

# Producción / Docker (PostgreSQL):
# Opción A — URL explícita (contraseña con caracteres especiales debe estar URL-encoded):
# DATABASE_URL=postgresql+psycopg2://empleados:CAMBIAR_PASSWORD@localhost:5432/empleados_ia

# Opción B — componentes (recomendado en Docker; contraseñas robustas con @ # % : / + OK):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=empleados
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_EN_PROD
POSTGRES_DB=empleados_ia

# -----------------------------------------------------------------------------
# SEGURIDAD
# -----------------------------------------------------------------------------
JWT_SECRET=generar-clave-larga-aleatoria-min-32-chars

# -----------------------------------------------------------------------------
# CORS (obligatorio en PROD — no dejar abierto)
# -----------------------------------------------------------------------------
# DEV/TEST:
CORS_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
# PROD ejemplo:
# CORS_ORIGINS=https://app.ejemplo.com

# -----------------------------------------------------------------------------
# DOCUMENTACIÓN API (/docs, /redoc)
# -----------------------------------------------------------------------------
# En PROD se deshabilita por defecto. Para habilitar explícitamente:
# ENABLE_API_DOCS=true

# -----------------------------------------------------------------------------
# BOOTSTRAP INICIAL (solo primera instalación — obligatorio en Docker/PostgreSQL)
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_PASSWORD_EN_PROD
BOOTSTRAP_ORG_NAME=Empresa demo
# Desarrollo local SQLite sin Docker: el backend usa defaults de config.py solo en dev.

# -----------------------------------------------------------------------------
# BACKUP
# -----------------------------------------------------------------------------
# Directorio local para dumps PostgreSQL (scripts/pg_backup.py)
BACKUP_DIR=data/backups

# -----------------------------------------------------------------------------
# DOCKER COMPOSE (puertos publicados)
# -----------------------------------------------------------------------------
BACKEND_PORT=8010
FRONTEND_PORT=5180

# -----------------------------------------------------------------------------
# LLM Gateway — Paquete B (secretos vía entorno, no en base de datos)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker (backend en contenedor, Ollama en host Windows):
# OLLAMA_BASE_URL=http://host.docker.internal:11434
