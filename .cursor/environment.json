{
  "name": "EMPLEADOS_IA",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": ".venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8010 --reload --app-dir backend"
    },
    {
      "name": "frontend",
      "command": "npm run dev --prefix frontend"
    }
  ],
  "ports": [8010, 5180]
}
